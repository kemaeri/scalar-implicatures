        <Param val="if ((expInfo[&quot;group&quot;] === &quot;native&quot;)) {&amp;#10;    text = &quot;***** EXP\u00c9RIENCE EN LIGNE *****    \n\n\nVous avez compl\u00e9t\u00e9 la premi\u00e8re t\u00e2che. Dans cette exp\u00e9rience, vous accomplirez les deux derni\u00e8res t\u00e2ches.     \n\n\n[BARRE D'ESPACE]&quot;;&amp;#10;} else {&amp;#10;    text = &quot;****** ONLINE EXPERIMENT*****    \n\n\nYou have completed the first task. In this experiment you will complete the final two tasks.    \n\n\n[SPACEBAR]&quot;;&amp;#10;}&amp;#10;textWelcome.setText(text);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if expInfo[&quot;group&quot;] == &quot;native&quot;:&amp;#10;    text = &quot;***** EXPÉRIENCE EN LIGNE *****\&amp;#10;    \n\n\nVous avez complété la première tâche. Dans cette expérience, vous accomplirez les deux dernières tâches. \&amp;#10;    \n\n\n[BARRE D\'ESPACE]&quot;&amp;#10;else:&amp;#10;    text = &quot;****** ONLINE EXPERIMENT*****\&amp;#10;    \n\n\nYou have completed the first task. In this experiment you will complete the final two tasks.\&amp;#10;    \n\n\n[SPACEBAR]&quot;&amp;#10;    &amp;#10;textWelcome.setText(text)" valType="extendedCode" updates="constant" name="Begin Routine"/>
