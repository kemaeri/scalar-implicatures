  <Flow>
    <Routine name="welcome"/>
    <Routine name="taskSI"/>
    <LoopInitiator loopType="TrialHandler" name="implicatures">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'id': 1, 'scale_term': 'spéciale/unique', 'scale_type': 'B', 'condition': 'test', 'speaker': 'Julie', 'sentence': 'le collier est spéciale', 'negation': &quot;le collier n'est pas unique&quot;}, {'id': 2, 'scale_term': 'faible/vide', 'scale_type': 'B', 'condition': 'test', 'speaker': 'Julie', 'sentence': 'la pile est faible', 'negation': &quot;la pile n'est pas vide&quot;}, {'id': 3, 'scale_term': 'dure/insoluble', 'scale_type': 'B', 'condition': 'test', 'speaker': 'Julie', 'sentence': 'la tâche est dure', 'negation': &quot;la tache n'est pas insoluble&quot;}, {'id': 4, 'scale_term': 'mémorable/inoubliable', 'scale_type': 'B', 'condition': 'test', 'speaker': 'Julie', 'sentence': 'le voyage est mémorable', 'negation': &quot;le voyage n'est pas inoubliable&quot;}, {'id': 5, 'scale_term': 'calme/inaudible', 'scale_type': 'B', 'condition': 'test', 'speaker': 'Julie', 'sentence': 'la classe est calme', 'negation': &quot;la classe n'est pas inaudible&quot;}, {'id': 6, 'scale_term': 'mouillé/trempé', 'scale_type': 'B', 'condition': 'test', 'speaker': 'Julie', 'sentence': 'la serviette est mouillée', 'negation': &quot;la serviette n'est pas trempée&quot;}, {'id': 7, 'scale_term': 'triste/abattu', 'scale_type': 'B', 'condition': 'test', 'speaker': 'Paul', 'sentence': 'la fille est triste', 'negation': &quot;la fille n'est pas abattue&quot;}, {'id': 8, 'scale_term': 'difficile/impossible', 'scale_type': 'B', 'condition': 'test', 'speaker': 'Paul', 'sentence': 'le test est difficile', 'negation': &quot;le test n'est pas impossible&quot;}, {'id': 9, 'scale_term': 'bon/parfait', 'scale_type': 'B', 'condition': 'test', 'speaker': 'Paul', 'sentence': 'la réponse est bonne', 'negation': &quot;la réponse n'est pas parfaite&quot;}, {'id': 10, 'scale_term': 'respectable/honorable', 'scale_type': 'B', 'condition': 'test', 'speaker': 'Paul', 'sentence': 'le soldat est respectable', 'negation': &quot;le soldat n'est pas honorable&quot;}, {'id': 11, 'scale_term': 'vif/éblouissant', 'scale_type': 'B', 'condition': 'test', 'speaker': 'Paul', 'sentence': 'la lumière est vive', 'negation': &quot;la lumière n'est pas éblouissante&quot;}, {'id': 12, 'scale_term': 'fatigué/épuisé', 'scale_type': 'NB', 'condition': 'test', 'speaker': 'Julie', 'sentence': &quot;l'athlète est fatigué&quot;, 'negation': &quot;l'athlète n'est pas épuisé&quot;}, {'id': 13, 'scale_term': 'goûteux/délicieux', 'scale_type': 'NB', 'condition': 'test', 'speaker': 'Julie', 'sentence': 'le repas est goûteux', 'negation': &quot;le repas n'est pas délicieux&quot;}, {'id': 14, 'scale_term': 'vieux/ancien', 'scale_type': 'NB', 'condition': 'test', 'speaker': 'Julie', 'sentence': 'la statue est vieille', 'negation': &quot;la statue n'est pas ancienne&quot;}, {'id': 15, 'scale_term': 'gros/énorme', 'scale_type': 'NB', 'condition': 'test', 'speaker': 'Julie', 'sentence': 'le bâtiment est gros', 'negation': &quot;le bâtiment n'est pas énorme&quot;}, {'id': 16, 'scale_term': 'gras/obèse', 'scale_type': 'NB', 'condition': 'test', 'speaker': 'Julie', 'sentence': 'le cuisinier est gras', 'negation': &quot;le cuisinier n'est pas obèse&quot;}, {'id': 17, 'scale_term': 'a faim/affamé', 'scale_type': 'NB', 'condition': 'test', 'speaker': 'Paul', 'sentence': 'le voyageur a faim', 'negation': &quot;le voyageur n'est pas affamé&quot;}, {'id': 18, 'scale_term': 'beau/sublime', 'scale_type': 'NB', 'condition': 'test', 'speaker': 'Paul', 'sentence': 'l’actrice est belle', 'negation': &quot;l'actrice n'est pas sublime&quot;}, {'id': 19, 'scale_term': 'mignon/beau', 'scale_type': 'NB', 'condition': 'test', 'speaker': 'Paul', 'sentence': 'le chat est mignon', 'negation': &quot;le chat n'est pas beau&quot;}, {'id': 20, 'scale_term': 'drôle/hilarant', 'scale_type': 'NB', 'condition': 'test', 'speaker': 'Paul', 'sentence': 'la blague est drôle', 'negation': &quot;la blague n'est pas hilarante&quot;}, {'id': 21, 'scale_term': 'moche/hideux', 'scale_type': 'NB', 'condition': 'test', 'speaker': 'Paul', 'sentence': 'le portrait est moche', 'negation': &quot;le portrait n'est pas hideux&quot;}, {'id': 22, 'scale_term': 'intelligent/brilliant', 'scale_type': 'NB', 'condition': 'test', 'speaker': 'Paul', 'sentence': 'le chercheur est intelligent', 'negation': &quot;le chercheur n'est pas briljant&quot;}, {'id': 23, 'scale_term': 'lent/rapide', 'scale_type': None, 'condition': 'filler-true', 'speaker': 'Julie', 'sentence': 'le train est rapide', 'negation': &quot;le train n'est pas lent&quot;}, {'id': 24, 'scale_term': 'sale/propre', 'scale_type': None, 'condition': 'filler-true', 'speaker': 'Julie', 'sentence': 'la cuisine est sale', 'negation': &quot;la cuisine n'est pas propre&quot;}, {'id': 25, 'scale_term': 'pauvre/riche', 'scale_type': None, 'condition': 'filler-true', 'speaker': 'Julie', 'sentence': &quot;l'homme est pauvre&quot;, 'negation': &quot;l'homme n'est pas riche&quot;}, {'id': 26, 'scale_term': 'superficiel/profond', 'scale_type': None, 'condition': 'filler-true', 'speaker': 'Julie', 'sentence': &quot;l'histoire est superficielle&quot;, 'negation': &quot;l'histoire n'est pas profonde&quot;}, {'id': 27, 'scale_term': 'léger/lourd', 'scale_type': None, 'condition': 'filler-true', 'speaker': 'Julie', 'sentence': 'le sac est léger', 'negation': &quot;le sac n'est pas lourd&quot;}, {'id': 28, 'scale_term': 'petit/grand', 'scale_type': None, 'condition': 'filler-true', 'speaker': 'Julie', 'sentence': 'le bébé est petit', 'negation': &quot;le bébé n'est pas grand&quot;}, {'id': 29, 'scale_term': 'gentil/méchant', 'scale_type': None, 'condition': 'filler-true', 'speaker': 'Paul', 'sentence': 'le chien est gentil', 'negation': &quot;le chien n'est pas méchant&quot;}, {'id': 30, 'scale_term': 'fermé/ouvert', 'scale_type': None, 'condition': 'filler-true', 'speaker': 'Paul', 'sentence': 'le magasin est fermé', 'negation': &quot;le magasin n'est pas ouvert&quot;}, {'id': 31, 'scale_term': 'noir/blanc', 'scale_type': None, 'condition': 'filler-true', 'speaker': 'Paul', 'sentence': 'le cheval est noir', 'negation': &quot;le cheval n'est pas blanc&quot;}, {'id': 32, 'scale_term': 'froid/chaud', 'scale_type': None, 'condition': 'filler-true', 'speaker': 'Paul', 'sentence': 'le thé est froid', 'negation': &quot;le thé n'est pas chaud&quot;}, {'id': 33, 'scale_term': 'actif/paresseux', 'scale_type': None, 'condition': 'filler-true', 'speaker': 'Paul', 'sentence': 'le garçon est actif', 'negation': &quot;le garçon n'est pas paresseux&quot;}, {'id': 34, 'scale_term': 'large/colorée', 'scale_type': None, 'condition': 'filler-false', 'speaker': 'Julie', 'sentence': 'la peinture est large', 'negation': &quot;la peinture n'est pas colorée&quot;}, {'id': 35, 'scale_term': 'joli/fort', 'scale_type': None, 'condition': 'filler-false', 'speaker': 'Julie', 'sentence': 'le modèle est joli', 'negation': &quot;le modèle n'est pas fort&quot;}, {'id': 36, 'scale_term': 'timide/curieux', 'scale_type': None, 'condition': 'filler-false', 'speaker': 'Julie', 'sentence': &quot;l'enfant est timide&quot;, 'negation': &quot;l'enfant n'est pas curieux&quot;}, {'id': 37, 'scale_term': 'fou/dangereux', 'scale_type': None, 'condition': 'filler-false', 'speaker': 'Julie', 'sentence': 'le criminel est fou', 'negation': &quot;le clown n'est pas dangereux&quot;}, {'id': 38, 'scale_term': 'effrayant/marron', 'scale_type': None, 'condition': 'filler-false', 'speaker': 'Julie', 'sentence': &quot;l'ours est effrayant&quot;, 'negation': &quot;l'ours n'est pas marron&quot;}, {'id': 39, 'scale_term': 'fâché/raisonnable', 'scale_type': None, 'condition': 'filler-false', 'speaker': 'Paul', 'sentence': 'le professeur est fâché', 'negation': &quot;le professeur n'est pas strict&quot;}, {'id': 40, 'scale_term': 'cher/ennuyeuse', 'scale_type': None, 'condition': 'filler-false', 'speaker': 'Paul', 'sentence': 'la robe est chère', 'negation': &quot;la robe n'est pas ennuyeuse&quot;}, {'id': 41, 'scale_term': 'doux/fin', 'scale_type': None, 'condition': 'filler-false', 'speaker': 'Paul', 'sentence': 'la couverture est douce', 'negation': &quot;la couverture n'est pas fine&quot;}, {'id': 42, 'scale_term': 'jeune/sérieux', 'scale_type': None, 'condition': 'filler-false', 'speaker': 'Paul', 'sentence': &quot;l'étudiant est jeune&quot;, 'negation': &quot;l'étudiant n'est pas sérieux&quot;}, {'id': 43, 'scale_term': 'poli/pressé', 'scale_type': None, 'condition': 'filler-false', 'speaker': 'Paul', 'sentence': 'le propriétaire est poli', 'negation': &quot;le propriétaire n'est pas pressé&quot;}, {'id': 44, 'scale_term': 'stupide/inquiet', 'scale_type': None, 'condition': 'filler-false', 'speaker': 'Paul', 'sentence': 'le candidat est stupide', 'negation': &quot;le candidat n'est pas inquiet&quot;}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="resources/stimuliMainTask.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
